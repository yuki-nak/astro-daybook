---
import { site, shelves } from '../site.config';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = site.description } = Astro.props;
const pageTitle = title ? `${title} | ${site.title}` : site.title;
const path = Astro.url.pathname;
const nav = [
  { href: '/', label: 'All' },
  { href: '/diary/', label: 'Diary' },
  { href: shelves.notes.path, label: shelves.notes.label },
  { href: shelves.works.path, label: shelves.works.label },
  { href: '/tags/', label: 'Tags' },
];
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f7f5f0" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <header class="site-header">
      <a href="/" class="site-title">{site.title}</a>
      <nav aria-label="Menu">
        {
          nav.map((n) => (
            <a href={n.href} aria-current={isActive(n.href) ? 'page' : undefined}>
              {n.label}
            </a>
          ))
        }
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer class="site-footer">
      <p>
        Weather for {site.location.name} from <a href="https://open-meteo.com/" rel="noopener">Open-Meteo</a>
      </p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --paper: #f7f5f0;
    --ink: #2a2826;
    --muted: #807a70;
    --rule: #dedad0;
    --accent: #9a3b2c;
    --measure: 36rem;
  }

  @media (prefers-color-scheme: dark) {
    :root {
      --paper: #1d1c1a;
      --ink: #e6e2da;
      --muted: #9b958a;
      --rule: #3a3833;
      --accent: #d88a78;
    }
  }

  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  html {
    background: var(--paper);
    color: var(--ink);
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
    font-size: 16px;
    line-height: 1.7;
    -webkit-text-size-adjust: 100%;
  }

  body {
    margin: 0 auto;
    max-width: calc(var(--measure) + 3rem);
    padding: 0 1.5rem;
  }

  a {
    color: inherit;
    text-decoration: none;
  }

  .prose a {
    text-decoration: underline;
    text-decoration-color: var(--rule);
    text-underline-offset: 0.25em;
  }

  .site-header {
    padding: 3rem 0 2.25rem;
    text-align: center;
  }

  .site-title {
    font-family: Georgia, 'Iowan Old Style', 'Times New Roman', serif;
    font-size: 1.4rem;
    font-weight: 600;
    letter-spacing: 0.08em;
  }

  .site-header nav {
    margin-top: 0.75rem;
    display: flex;
    justify-content: center;
    gap: 1.5em;
    font-size: 0.85rem;
    color: var(--muted);
  }

  .site-header nav a[aria-current='page'] {
    color: var(--ink);
    border-bottom: 1px solid var(--ink);
  }

  main {
    min-height: 60vh;
  }

  h1,
  h2,
  h3 {
    font-weight: 600;
    line-height: 1.6;
  }

  .page-title {
    font-size: 1rem;
    text-align: center;
    color: var(--muted);
    font-weight: 400;
    margin: 0 0 2rem;
  }

  .muted {
    color: var(--muted);
  }

  .empty {
    text-align: center;
    color: var(--muted);
  }

  .prose p {
    margin: 0 0 1.2em;
  }
  .prose blockquote {
    margin: 1.5em 0;
    padding-left: 1em;
    border-left: 3px solid var(--rule);
    color: var(--muted);
  }
  .prose h2,
  .prose h3 {
    font-size: 1rem;
    margin: 2em 0 0.75em;
  }
  .prose ul,
  .prose ol {
    padding-left: 1.4em;
  }
  .prose img {
    display: block;
    max-width: 100%;
    height: auto;
    margin: 1.5em auto 0.4em;
    border-radius: 4px;
  }
  .prose hr {
    border: none;
    border-top: 1px solid var(--rule);
    margin: 2.5em 0;
  }

  .site-footer {
    margin-top: 5rem;
    padding: 2rem 0 3rem;
    border-top: 1px solid var(--rule);
    font-size: 0.75rem;
    color: var(--muted);
    text-align: center;
  }

  .site-footer a {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }
</style>
